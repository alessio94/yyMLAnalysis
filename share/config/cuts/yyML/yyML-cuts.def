# -*- mode: tqfolder -*-
# to get proper syntax highlighting and indentation when using emacs,
# add the following line to your .emacs file:
#   (load-file "$TQPATH/share/tqfolder.el")

+CutChannels {
    <.cutExpression = "$(fitsChannel)", .weightExpression = "$(weights)", .title="Channel Selection">

    #+CutTrigger {
    #    <.cutExpression = "$(passTrigger)", .title="Trigger Selection">

    #    +CutTriggerMatching {
    #        <.cutExpression = "$(passTriggerMatching)", .title="Trigger Matching">

    +CutDataBlind {
        <.cutExpression = "$(isData)? ((120 > $(m_yy)) || ($(m_yy) > 130)) : 1", .title="Data blinding">

        +Cut2AnalysisPhotons {
            <.cutExpression = "$(n_loose_noniso_photons) == 2", .title="2 Loose/NonIso photons">

            +CutIDTightISOLoosePhotons {
                <.cutExpression = "$(phot1_IDTight_ISOLoose) && $(phot2_IDTight_ISOLoose)", .title="2 Tight/IsoLoose photons">

                +CutPhotonCrackVeto {
                    <.cutExpression = "(fabs($(phot1_eta)) < 1.37 || fabs($(phot1_eta)) > 1.52) && (fabs($(phot2_eta)) < 1.37 || fabs($(phot2_eta)) > 1.52)", .title="Photon crack region veto">

                    +Cutmyy {
                        <.cutExpression = "(105 < $(m_yy)) && ($(m_yy) < 160)", .title="2 Tight/IsoLoose photons">

                        +CutETy1 {
                            <.cutExpression = "$(phot1_pt) > 35", .title="E_{T}(y1) > 35 GeV">

                            +Cuty1_pT_to_myy_ratio {
                                <.cutExpression = "$(phot1_pt)/$(m_yy) > 0.35", .title="y1: p_{T}/m_{yy} > 0.35">

                                +Cuty2_pT_to_myy_ratio {
                                    <.cutExpression = "($(phot2_pt)/$(m_yy)) > 0.35", .title="y2: p_{T}/m_{yy} > 0.35">

                                    +CutMET {
                                        <.cutExpression = "$(met_met) > 35", .title="MET > 35 GeV">

                                        +Cutbveto {
                                            <.cutExpression = "$(n_b_jet) == 0", .title="b-veto (GN2v1 @ 77%)">

                                            +CutNLepTau {
                                                <.cutExpression = "$(NLepTau_cut)", .title="Number of leptons/taus">

                                                +CutLepTauEta {
                                                    <.cutExpression = "$(LepTauEta_cut)", .title="Lepton/tau eta">

                                                    +CutLepd0sig {
                                                        <.cutExpression = "$(Lepd0sig_cut)", .title="Lepton d0sig">

                                                        +CutLepz0sintheta {
                                                            <.cutExpression = "$(Lepz0sintheta_cut)", .title="Lepton z0sintheta">

                                                            +CutTauEleVeto {
                                                                <.cutExpression = "$(TauEleVeto_cut)", .title="Tau eVeto">

                                                                +Cut2LOC {
                                                                    <.cutExpression = "$(2LOC_cut)", .title="2L opposite charge">

                                                                    +Cut2Lmll {
                                                                        <.cutExpression = "$(2Lmll_cut)", .title="2L mll > 12 GeV">

                                                                        +CutMCBlind {
                                                                            <.cutExpression = "$(isMC)? ((120 > $(m_yy)) || ($(m_yy) > 130)) : 1", .title="MC blinding">

                                                                        } #End: CutMCBlind
                                                                    } #End: Cut2Lmll
                                                                } #End: Cut2LOC
                                                            } #End: CutTauEleVeto
                                                        } #End: CutLepz0sintheta
                                                    } #End: CutLepd0sig
                                                } #End: CutLepEta
                                            } #End: CutNLep
                                        } #End: Cutbveto
                                    } #End: CutMET
                                } #End: Cuty2_pT_to_myy_ratio
                            } #End: Cuty1_pT_to_myy_ratio
                        } #End: CutETy1
                    } #End: Cutmyy
                } #End: CutPhotonCrackVeto
            } #End: CutIDTightISOLoosePhotons
        } #End: Cut2AnalysisPhotons
    } #End: CutDataBlind

    #    } #End: CutTriggerMatching
    #} #End: CutTrigger
} #End: CutChannels
