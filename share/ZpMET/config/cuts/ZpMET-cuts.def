+CutInitial {
  <.cutExpression = "1", .weightExpression = "[generatorWeight_NOSYS]*[PileupWeight_NOSYS]*[jvt_effSF_NOSYS]", .title = "Initial">

  +CutLeadLepPt {
    <.cutExpression = "[VecAT([el_pt_NOSYS],0)] > 27000.", .title = "Leading electron pT > 27 GeV">

    +CutMET {
      <.cutExpression = "[met_met_NOSYS] > 80000.", .title = "MET > 80 GeV">
    } #End: CutMET
  } #End: CutLeadLepPt

} #End: CutInitial
