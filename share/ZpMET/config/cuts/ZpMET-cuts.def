# ZpMET cuts definition file
# Based on actual AnalysisMiniTree branch names from EasyJet ntuples
#
# IMPORTANT: branches are vectors (e.g. el_pt_NOSYS, mu_pt_NOSYS).
# CAF accesses vector elements with _0, _1, _2 suffixes automatically
# when using the flatNTuple reader (e.g. [el_pt_NOSYS_0] = leading el pT).
#
# All pT/MET values are in MeV.

# ── Root cut ──────────────────────────────────────────────────────────────────
+CutInitial {
  <.cutExpression    = "1",
   .weightExpression = "[generatorWeight_NOSYS]*[PileupWeight_NOSYS]*[jvt_effSF_NOSYS]",
   .title            = "Initial">

  # ── Trigger: ee OR mm ──────────────────────────────────────────────────────
  +CutTrigger {
    <.cutExpression = "([trigPassed_HLT_e26_lhtight_ivarloose_L1eEM26M] || [trigPassed_HLT_e60_lhmedium_L1eEM26M] || [trigPassed_HLT_e140_lhloose_L1eEM26M]) || ([trigPassed_HLT_mu24_ivarmedium_L1MU14FCH] || [trigPassed_HLT_mu50_L1MU14FCH] || [trigPassed_HLT_mu60_L1MU14FCH])",
     .title = "Trigger">

    # ── ee channel ─────────────────────────────────────────────────────────
    +CutEETrigger {
      <.cutExpression = "[trigPassed_HLT_e26_lhtight_ivarloose_L1eEM26M] || [trigPassed_HLT_e60_lhmedium_L1eEM26M] || [trigPassed_HLT_e140_lhloose_L1eEM26M]",
       .title = "ee trigger">

      +CutEE2El {
        <.cutExpression = "[el_passesOR_NOSYS_0] == 1 && [el_passesOR_NOSYS_1] == 1",
         .title = "2 electrons pass OR">

        +CutEEOS {
          <.cutExpression = "[el_charge_NOSYS_0] * [el_charge_NOSYS_1] < 0",
           .title = "OS electrons">

          +CutEEPt {
            <.cutExpression = "[el_pt_NOSYS_0] > 27000. && [el_pt_NOSYS_1] > 20000.",
             .title = "Electron pT cuts">

            +CutEEMET {
              <.cutExpression = "[met_met_NOSYS] > 80000.",
               .title = "MET > 80 GeV (ee)">
            } #End: CutEEMET
          } #End: CutEEPt
        } #End: CutEEOS
      } #End: CutEE2El
    } #End: CutEETrigger

    # ── mm channel ─────────────────────────────────────────────────────────
    +CutMMTrigger {
      <.cutExpression = "[trigPassed_HLT_mu24_ivarmedium_L1MU14FCH] || [trigPassed_HLT_mu50_L1MU14FCH] || [trigPassed_HLT_mu60_L1MU14FCH]",
       .title = "mm trigger">

      +CutMM2Mu {
        <.cutExpression = "[mu_passesOR_NOSYS_0] == 1 && [mu_passesOR_NOSYS_1] == 1",
         .title = "2 muons pass OR">

        +CutMMOS {
          <.cutExpression = "[mu_charge_NOSYS_0] * [mu_charge_NOSYS_1] < 0",
           .title = "OS muons">

          +CutMMPt {
            <.cutExpression = "[mu_pt_NOSYS_0] > 27000. && [mu_pt_NOSYS_1] > 20000.",
             .title = "Muon pT cuts">

            +CutMMMET {
              <.cutExpression = "[met_met_NOSYS] > 80000.",
               .title = "MET > 80 GeV (mm)">
            } #End: CutMMMET
          } #End: CutMMPt
        } #End: CutMMOS
      } #End: CutMM2Mu
    } #End: CutMMTrigger

  } #End: CutTrigger
} #End: CutInitial
