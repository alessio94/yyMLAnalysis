# -*- mode: tqfolder -*-
# this files name is 'cuts.txt'
# to get proper syntax highlighting and indentation when using emacs,
# add the following line to your .emacs file:
#   (load-file "$TQPATH/share/tqfolder.el")


+CutHH_3L {
  # to use the per-event event weights properly, use mcWeight and recoWeight in the following two .weightExpressions here (so that mcWeight*recoWeight = eventWeight is applied after CutChannels).
    <.cutExpression = "$(fitsChannel)", .weightExpression="$(mcWeight)", .title = "Fits channel"> # @Event$(cand).size() > 0
    +_CutChannels {
        <.cutExpression = "$(fitsChannel)">  # @Event$(cand).size() > 0
                +CutLeptons {
                    <.cutExpression = "1.", .title="Lep cuts">
                    +LepCutLep0Eta { 
                        <.cutExpression = "(([fabs($(l0).eta())] < 1.37 || ([fabs($(l0).eta())] > 1.52 && [fabs($(l0).eta())] < 2.47)) && [$(lep0_is_e)])
                                          || ([fabs($(l0).eta())] < 2.5 && [$(lep0_is_m)])", 
                                          .title="$|\eta^{\rm l0} < 2.5$, veto transition region (el)">
                    +LepCutLep1Eta {
                        <.cutExpression = "(([fabs($(l1).eta())] < 1.37 || ([fabs($(l1).eta())] > 1.52 && [fabs($(l1).eta())] < 2.47)) 
                                          && [$(lep1_is_e)]) || ([fabs($(l1).eta())] < 2.5 && [$(lep1_is_m)])",
                                          .title="$|\eta^{\rm l1} < 2.5$, veto transition region (el)">
                    +LepCutLep2Eta {
                        <.cutExpression = "(([fabs($(l2).eta())] < 1.37 || ([fabs($(l2).eta())] > 1.52 && [fabs($(l2).eta())] < 2.47)) 
                                          && [$(lep2_is_e)]) || ([fabs($(l2).eta())] < 2.5 && [$(lep2_is_m)])",
                                          .title="$|\eta^{\rm l2} < 2.5$, veto transition region (el)">
                    +LepCutLepEta {
                        <.cutExpression = "1.", .title="CutLepEta">
                    +LepCutLepCharge {
                        <.cutExpression = "!($(lep_q0xq1) == $(lep_q0xq2) && $(lep_q0xq1) == $(lep_q1xq2))", .title="Cut charge">
                    +LepCutLep0ECIDS_e { 
                        <.cutExpression = "([$(lep0ElECIDS)] && [$(lep0_is_e)]) ||  [$(lep0_is_m)]", .title="Lepton 0 el ECIDS ">
                    +LepCutLep1ECIDS_e { 
                        <.cutExpression = "([$(lep1ElECIDS)] && [$(lep1_is_e)]) ||  [$(lep1_is_m)]", .title="Lepton 1 el ECIDS ">
                    +LepCutLep2ECIDS_e { 
                        <.cutExpression = "([$(lep2ElECIDS)] && [$(lep2_is_e)]) ||  [$(lep2_is_m)]", .title="Lepton 2 el ECIDS ">
                    +LepCutLepECIDS_e { 
                        <.cutExpression = "1.", .title="Lepton ECIDS">
                    +LepCutLep0Author { 
                        <.cutExpression = "([$(lep0_author)] > 0 && [$(lep0_is_e)]) || [$(lep0_is_m)]", .title="$author^{\rm l0}">
                    +LepCutLep1Author {
                        <.cutExpression = "([$(lep1_author)] > 0 && [$(lep1_is_e)]) || [$(lep1_is_m)]", .title="$author^{\rm l1}">
                    +LepCutLep2Author {
                        <.cutExpression = "([$(lep2_author)] > 0 && [$(lep2_is_e)]) || [$(lep2_is_m)]", .title="$author^{\rm l2}">
                    +LepCutLepAuthor {
                        <.cutExpression = "1.", .title="Lepton author > 0">
                    +LepCutLep0Pt { 
                        <.cutExpression = "[$(l0).pt()] > 10000.", .title="$p_{t}^{\rm l0} > 10$ GeV">
                        #<.cutExpression = "[$(l0).pt()] > 25000.", .title="$p_{t}^{\rm l0} > 25$ GeV">
                    +LepCutLep1Pt {
                        <.cutExpression = "[$(l1).pt()] > 15000.", .title="$p_{t}^{\rm l1} > 15$ GeV">
                        #<.cutExpression = "[$(l1).pt()] > 25000.", .title="$p_{t}^{\rm l1} > 25$ GeV">
                    +LepCutLep2Pt {
                        <.cutExpression = "[$(l2).pt()] > 15000.", .title="$p_{t}^{\rm l2} > 15$ GeV">
                        #<.cutExpression = "[$(l2).pt()] > 25000.", .title="$p_{t}^{\rm l2} > 25$ GeV">
                    +LepCutLepPt {
                        <.cutExpression = "1.", .title="Lepton pt">
                    +LepCutLowMassVeto {
                        <.cutExpression =  "!(($(01IsSF) && $(Mll01) < 12000.) || ($(02IsSF) && $(Mll02) < 12000))", .title="LowMassVeto">
                    +LepCutZMassMll {
                        <.cutExpression = "(($(01IsSF) && fabs($(Mll01) - $(mZ)) < 10000.) || ($(02IsSF) && fabs($(Mll02) - $(mZ)) < 10000.))",
                                          .title="ZMassVeto"> 
                    +LepCutZMassMlll {
                        <.cutExpression = "!(fabs([$(Mlll)] - $(mZ)) < 10000.)", .title="ZMassVetoMlll">
                    +LepCutLep0ID_L { 
                        <.cutExpression = "([$(lep0ElIDLHLoose)] && [$(lep0_is_e)]) ||  ([$(lep0_is_m)] && [$(lep0MuQuality)] <= 2)", .title="Lepton 0 ID Loose">
                    +LepCutLep1ID_L { 
                        <.cutExpression = "([$(lep1ElIDLHLoose)] && [$(lep1_is_e)]) ||  ([$(lep1_is_m)] && [$(lep1MuQuality)] <= 2)", .title="Lepton 1 ID Loose">
                    +LepCutLep2ID_L { 
                        <.cutExpression = "([$(lep2ElIDLHLoose)] && [$(lep2_is_e)]) ||  ([$(lep2_is_m)] && [$(lep2MuQuality)] <= 2)", .title="Lepton 2 ID Loose">
                    +LepCutLep0Iso_L { 
                        #<.cutExpression = "[$(lep0_passIsoPLVLoose)]", .title="Lepton 0 PLVLoose">
                        <.cutExpression = "[$(lep0_passIsoLoose_VarRad)]", .title="Lepton 0 VarRad_Loose">
                    +LepCutLep1Iso_L { 
                        #<.cutExpression = "[$(lep1_passIsoPLVLoose)]", .title="Lepton 1 PLVLoose">
                        <.cutExpression = "[$(lep1_passIsoLoose_VarRad)]", .title="Lepton 1 VarRad_Loose">
                    +LepCutLep2Iso_L { 
                        #<.cutExpression = "[$(lep2_passIsoPLVLoose)]", .title="Lepton 2 PLVLoose">
                        <.cutExpression = "[$(lep2_passIsoLoose_VarRad)]", .title="Lepton 2 VarRad_Loose">
                    +LepCutLepLoose { 
                        <.cutExpression = "1.", .title="Lepton Loose quality">
                    +LepCutLep1ID_T { 
                        <.cutExpression = "([$(lep1ElIDLHTight)] && [$(lep1_is_e)]) ||  ([$(lep1_is_m)] && [$(lep1MuQuality)] <= 1)", .title="Lepton 1 ID Tight">
                    +LepCutLep2ID_T { 
                        <.cutExpression = "([$(lep2ElIDLHTight)] && [$(lep2_is_e)]) ||  ([$(lep2_is_m)] && [$(lep2MuQuality)] <= 1)", .title="Lepton 2 ID Tight">
                    +LepCutLep0Iso_T {  # remove later
                        <.cutExpression = "[$(lep0_passIsoTight_VarRad)]", .title="Lepton 0 VarRad_Tight">
                    +LepCutLep1Iso_T { 
                        #<.cutExpression = "[$(lep1_passIsoPLVTight)]", .title="Lepton 1 PLVTight">
                        <.cutExpression = "[$(lep1_passIsoTight_VarRad)]", .title="Lepton 1 VarRad_Tight">
                    +LepCutLep2Iso_T { 
                        #<.cutExpression = "[$(lep2_passIsoPLVTight)]", .title="Lepton 2 PLVTight">
                        <.cutExpression = "[$(lep2_passIsoTight_VarRad)]", .title="Lepton 2 VarRad_Tight">
                    +LepCutLepTight { 
                        <.cutExpression = "1.", .title="Lepton Tight quality">
                    #+JetCutBVeto85 {
                    #    <.cutExpression = "$(nBJetsSubDL1dv01) == 0", .title="nBjets == 0 (b-jet veto)">
                    +MetCutMET {
                        <.cutExpression = "$(MET)/1000. > 30.", .title = "MET > 30 GeV">
                    +AfterWZCRCuts {
                        <.cutExpression = "1.", .title="After cuts">
                    +JetCut0Jets {
                        <.cutExpression = "$(nJets2525) == 0", .title="nJets == 0">
                    }
                    +JetCut1Jets {
                        <.cutExpression = "$(nJets2525) == 1", .title="nJets == 1">
                    }
                    +JetCut2plusJets {
                        <.cutExpression = "$(nJets2525) >= 2", .title="nJets >= 2">
                    }
                    +DebugPtlll {
                        <.cutExpression = "[$(lepPtSum)] < 30000.", .title="$p_{t}^{\rm lll} < 30$ GeV">
                    }
                }                                          # after all cuts
                }                                          # end Met Cuts
                #}                                          # end bJet Cut
                }}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}         # end Lep Cuts
                }                                          # end CutChannels
}

