# -*- mode: tqfolder -*-
# this files name is 'cuts.txt'
# to get proper syntax highlighting and indentation when using emacs,
# add the following line to your .emacs file:
#   (load-file "$TQPATH/share/tqfolder.el")


+CutSTXS {
  # to use the per-event event weights properly, use mcWeight and recoWeight in the following two .weightExpressions here (so that mcWeight*recoWeight = eventWeight is applied after CutChannels).
  <.cutExpression = "1.", .weightExpression="[mcWeight]", .title = "Signal split into STXS bins">
      +CutChannels {
        # Sometimes events can have a PRW weight of 0 (-> statistical dilution) - remove these events here
        <.cutExpression = "$(fitsChannel)", .weightExpression = "[jvtWeight] * [forwardJVTWeight] * [prwWeight]", .title="Channel Selection">
        +Cut2Leptons{
            <.cutExpression = "[nVetoLepton] == 0.", .title="Only two Leptons">
              +CutLeadLeptonPt {
                <.cutExpression = "[$(lep0).pt()] > 22000.", .title="$p_{t}^{lead} > 22$ GeV">
                +CutSubLeadLeptonPt {
                  <.cutExpression = "[$(lep1).pt()] > 15000", .title="$p_{t}^{\rm sublead} > 15$ GeV">
                  +CutOSandSSMll {
                      <.cutExpression = "$(Mll) > { $(isSF) ? 12000 : 10000 }", .title="$M_{\ell\ell} > 12/10$ GeV">
                  }
                  +CutOSLeptons {
                      <.cutExpression = "$(dilepCharge)==0", .title="OS Leptons", dlcName="">
                  }
                 }
              }
        }
      }
}



@*/CutOSLeptons {
  +CutMll$(dlcName) {
    <.cutExpression = "$(Mll) > { $(isSF) ? 12000 : 10000 }", .title="$M_{\ell\ell} > 12/10$ GeV">
    +CutZVeto$(dlcName) {
      <.cutExpression = "{ $(isSF)? abs($(Mll) - $(mZ)) > 15000. : 1.}", .title="SF: Z Veto">
      +CutLepSelection$(dlcName){
        <.cutExpression = "[leadLepID]>0 && [subleadLepID]>0", .title="Leptons ID (single Fakes = 1 Anti-ID, 1 ID; double Fakes $2 \times$ Anti-ID)">
        +CutDRll$(dlcName) {
          <.cutExpression = "{$(applyDRllCut) ? ($(DRll) > 0.1) : 1.}", .title = "$\Delta R_{\ell\ell} > 0.1$">
          +CutFF$(dlcName) {
            <.cutExpression = "1.", .weightExpression= "1.", .title = "Apply fake factor">
          }
        }
      }
    }
  }
}

@*/CutFF* {
  +CutMET$(dlcName) {
    <.cutExpression = "{ $(isSF)?  $(MET) > 45000. : 1.}", .title="SF: $E_{\textrm{T}}^{\textrm{miss}}>45$ GeV", METName = "">
    #<.cutExpression = "{ $(isSF)?  $(MET) > 45000. : $(TrackMET) > 20000. }", .title="SF: $E_{\textrm{T}}^{\textrm{miss}}>45$ GeV, DF: $p_{\textrm{T}}^{\textrm{miss}} > 20$ GeV", METName = "">
  }
}



@*/CutMET* {
  +CutGGF_0jet$(dlcName) {
    <.cutExpression = "$(nJetsTight) == 0", .title="0-jet">
    +CutGGF_MET_0jet$(dlcName) {
      <.cutExpression = " $(MET) > 20000.", .title="$E_{\textrm{T}}^{\textrm{miss}}>20$ GeV">
      +CutGGF_TopoMll_0jet$(dlcName) {
        <.cutExpression = " [$(Mll)] < 55000.", .title="$M_{\ell\ell}<55$ GeV">
        +CutGGF_bVeto_0jet$(dlcName) {
          <.cutExpression = "[nBJetsSubDL1r] < 1", .weightExpression="bTagWeightOTF20", .title="SR 0-jet $b$-veto">
	      +CutGGF_DPhillMET_0jet$(dlcName) {
            <.cutExpression = " [$(DPhillMET)] > 1.57", .title="$\Delta\Phi_{\ell\ell,\textrm{MET}} > 1.57$">
            +CutGGF_dRll_0jet$(dlcName) {
              <.cutExpression = " [sqrt( $(DEtall)*$(DEtall) + $(DPhill)*$(DPhill))] > 0.6", .title="$\Delta R_{\ell\ell} > 0.6$">
              +CutGGF_inter_TopoDPhill_0jet_loose$(dlcName) {
                <.cutExpression = " [$(DPhill)] < 2.0", .title="$\Delta \Phi_{\ell\ell}<2.0$">
                +CutGGF_TopoDPhill_0jet$(dlcName) {
                  <.cutExpression = " [$(DPhill)] < 1.8", .title="$\Delta \Phi_{\ell\ell}<1.8$">
                  +CutGGF_Ptll_0jet$(dlcName) {
                    <.cutExpression = " [$(Ptll)] > 30000.", .title="$p_{\textrm{T}}^{\ell\ell}>30$ GeV">
                  }
                }
              }
            }
	      }
        }
      }
    }
  }
  +CutGGF_1jet$(dlcName) {
    <.cutExpression = "$(nJetsTight) == 1", .title="1-jet">
    +CutGGF_bVeto_1jet$(dlcName) {
      <.cutExpression = "[nBJetsSubDL1r] < 1", .weightExpression="bTagWeightOTF20", .title="$b$-jet veto">
      +CutGGF_bVeto_1jet_PTH_000_060$(dlcName) {
        <.cutExpression = "$(pT_H)<= 60000.", .title="b-veto PTH_000_060">
      }
      +CutGGF_bVeto_1jet_PTH_060_120$(dlcName) {
        <.cutExpression = " 60000. < $(pT_H) && $(pT_H)<= 120000.", .title="b-veto PTH_060_120">
      }
      +CutGGF_bVeto_1jet_PTH_GT120$(dlcName) {
        <.cutExpression = "120000. < $(pT_H)", .title="b-veto PTH_GT120">
      }
      +CutGGF_TopoMll_1jet$(dlcName) {
        <.cutExpression = " [$(Mll)] < 55000.", .title="$M_{\ell\ell}<55$ GeV">
        +CutGGF_TopoMll_1jet_PTH_000_060$(dlcName) {
          <.cutExpression = "$(pT_H)<= 60000.", .title="TopoMll_1jet PTH_000_060">
        }
        +CutGGF_TopoMll_1jet_PTH_060_120$(dlcName) {
          <.cutExpression = " 60000. < $(pT_H) && $(pT_H)<= 120000.", .title="TopoMll_1jet PTH_060_120">
        }
        +CutGGF_TopoMll_1jet_PTH_GT120$(dlcName) {
          <.cutExpression = "120000. < $(pT_H)", .title="TopoMll_1jet PTH_GT120">
        }
        +CutGGF_TopoDPhill_1jet_loose$(dlcName) {
          <.cutExpression = " [$(DPhill)] < 2.0", .title="$\Delta \Phi_{\ell\ell}<2.0$">
          +CutGGF_TopoDPhill_1jet_loose_PTH_000_060$(dlcName) {
            <.cutExpression = "$(pT_H)<= 60000.", .title="TopoDPhill_1jet PTH_000_060">
          }
          +CutGGF_TopoDPhill_1jet_loose_PTH_060_120$(dlcName) {
            <.cutExpression = " 60000. < $(pT_H) && $(pT_H)<= 120000.", .title="TopoDPhill_1jet PTH_060_120">
          }
          +CutGGF_TopoDPhill_1jet_loose_PTH_GT120$(dlcName) {
            <.cutExpression = "120000. < $(pT_H)", .title="TopoDPhill_1jet PTH_GT120">
          }
          +CutGGF_inter_ZttVeto_1jet$(dlcName) {
            <.cutExpression = "{$(isSF)? 1. : [mtt] < ($(mZ) - 25000.) }", .title="$Z\to\tau\tau$ veto">
            +CutGGF_MaxMTlep_1jet$(dlcName) {
              <.cutExpression = "{$(isSF) ? 1. : max($(MTlep0),$(MTlep1)) > 50000. } ", .title="$M_{\textrm{T}}^{\ell}>50$ GeV">
              +CutGGF_TopoDPhill_1jet$(dlcName) {
                <.cutExpression = " [$(DPhill)] < 1.8", .title="$\Delta \Phi_{\ell\ell}<1.8$">
              }
            }
          }
        }
      }
    }
  }
}

# #######################################
# ###      1j      ###
# #######################################

@*/CutGGF_inter_ZttVeto_1jet* {
  +CutGGF_ZttVeto_1jet$(dlcName){
    <.cutExpression="$(doBlinded) ? ( $(isMC) || [$(dilepCharge)]!=0 ): 1.", BO="", title="CutGGF_ZttVeto_1jet">
  }
}

@*/CutGGF_ZttVeto_1jet* {
  +CutGGF_SR_DNN_1jet_PTH_000_060$(BO)$(dlcName) {
    <.cutExpression = "$(pT_H)<= 60000.", .title="SR_DNN_1jet_PTH_000_060">
  }
  +CutGGF_SR_DNN_1jet_PTH_060_120$(BO)$(dlcName) {
    <.cutExpression = "60000. < $(pT_H) && $(pT_H)<= 120000.", .title="SR_DNN_1jet_PTH_060_120">
  }
  +CutGGF_SR_DNN_1jet_PTH_120_200$(BO)$(dlcName) {
    <.cutExpression = "120000. < $(pT_H) && $(pT_H)<= 200000.", .title="SR_DNN_1jet_PTH_120_200">
  }
  +CutGGF_SR_DNN_1jet_PTH_200_300$(BO)$(dlcName) {
    <.cutExpression = "200000. < $(pT_H) && $(pT_H)<= 300000.", .title="SR_DNN_1jet_PTH_200_300">
  }
  +CutGGF_SR_DNN_1jet_PTH_GT300$(BO)$(dlcName) {
    <.cutExpression = "300000. < $(pT_H)", .title="SR_DNN_1jet_PTH_GT300">
  }
  +CutGGF_SR_DNN_1jet_PTH_GT120$(BO)$(dlcName) {
    <.cutExpression = "120000. < $(pT_H)", .title="SR_DNN_1jet_PTH_GT120">
  }
}

# #######################################
# ###      0j      ###
# #######################################

@*/CutGGF_inter_TopoDPhill_0jet_loose* {
  +CutGGF_TopoDPhill_0jet_loose$(dlcName){
    <.cutExpression="$(doBlinded) ? ( $(isMC) || [$(dilepCharge)]!=0 ): 1.", BO="", title="CutGGF_TopoDPhill_0jet_loose">
  }
}

@*/CutGGF_TopoDPhill_0jet_loose* {
  +CutGGF_SR_DNN_0jet_PTH_0_10$(BO)$(dlcName) {
    <.cutExpression = "$(pT_H)<= 10000.", .title="SR_DNN_0jet_PTH_0_10">
  }
  +CutGGF_SR_DNN_0jet_PTH_GT10$(BO)$(dlcName) {
    <.cutExpression = "10000. < $(pT_H)", .title="SR_DNN_0jet_PTH_GT10">
  }
}

